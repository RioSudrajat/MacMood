# ==============================================================================
# MacMood Production Environment Variables Template
# Copy this file to .env.production before running Docker Compose or deploying
# ==============================================================================

# Server & Runtime Configuration
NODE_ENV=production
PORT=3000

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# In Docker Compose, the host name is 'db'. On Railway or Managed DB, paste full URI.
# ------------------------------------------------------------------------------
POSTGRES_DB=macmood
POSTGRES_USER=macmood_user
POSTGRES_PASSWORD=ganti_dengan_password_database_yang_sangat_kuat_32karakter
DATABASE_URL=postgres://macmood_user:ganti_dengan_password_database_yang_sangat_kuat_32karakter@db:5432/macmood

# ------------------------------------------------------------------------------
# Authentication (Better Auth)
# Generate a secure 32+ character random hex string:
# Command: openssl rand -hex 32
# ------------------------------------------------------------------------------
BETTER_AUTH_SECRET=ganti_dengan_string_random_hex_minimal_32_karakter
# URL domain produksi publik aplikasi Anda (tanpa trailing slash)
BETTER_AUTH_URL=https://pos.macmood.id

# ------------------------------------------------------------------------------
# Cloudflare R2 / S3 Compatible Object Storage (Untuk Upload Foto Menu Produk)
# Cloudflare R2 memiliki Free Tier 10 GB penyimpanan & 0 Rupiah Egress Fee
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=macmood-assets
R2_PUBLIC_URL=https://assets.macmood.id
